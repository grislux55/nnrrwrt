From: grislux55 <jebchou.hg@gmail.com>
Subject: [PATCH] net: airoha: restore factory RX control-ring limits

The AN7581 factory qdma_lan.ko and qdma_wan.ko initialize all 32 RX
ring rate limits in packet mode, then switch the ingress meter from TRTCM
to rate-limit mode. The XG-040G-MD startup script tightens the control
rings to 1000pps and leaves LAN ring 11 at 4000pps while WAN ring 11 is
also set to 1000pps.

Program the final factory ring values during QDMA initialization. Rings
0, 2, 8 and 9 use the slow tick; the remaining rings use the fast tick.
Use the programmed packet rate as the bucket size, matching the factory
SDK packet-mode calculation.

The 32-entry table and final mode write were read from each factory
module's .rodata at offset 0x670 and from the startup script. The setup
sequence was checked against the independent public SDK. Its
qdmaSetRxRatelimitDefaultConfig() and
qdma_general_set_ratelimit_mode_cfg() functions perform the same updates.

Factory modules: XG-040G-MD 7.3.160.1_v002, qdma_lan.ko SHA256
337d66fca6bef01d7e83f1d441e10585825816d61b15614efbde09cdd0a6d9c8 and
qdma_wan.ko SHA256
29713c102f67e71681b850e0aac387aacbaa734a7bc1058447d682f5a9eb23c8.
SDK reference: lotusmomo/airoha_sdk at
32b5aa356c2406edef8806aaf75451ff0a5286f2,
private/qdma/qdma_lan/qdma_dev.c.

Signed-off-by: grislux55 <jebchou.hg@gmail.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -2010,9 +2010,11 @@ static void airoha_qdma_init_multicast(struct airoha_qdma *qdma)
 				forwarding[i]);
 }
 
+static int airoha_qdma_set_factory_rx_limits(struct airoha_qdma *qdma);
+
 static int airoha_qdma_hw_init(struct airoha_qdma *qdma)
 {
-	int i;
+	int err, i;
 
 	for (i = 0; i < ARRAY_SIZE(qdma->irq_banks); i++) {
 		/* clear pending irqs */
@@ -2059,6 +2061,9 @@ static int airoha_qdma_hw_init(struct airoha_qdma *qdma)
 	airoha_qdma_init_multicast(qdma);
 
 	airoha_qdma_init_qos(qdma);
+	err = airoha_qdma_set_factory_rx_limits(qdma);
+	if (err)
+		return err;
 
 	/* disable qdma rx delay interrupt */
 	for (i = 0; i < ARRAY_SIZE(qdma->q_rx); i++) {
@@ -3743,6 +3748,9 @@ static int airoha_qdma_init_rl_config(struct airoha_qdma *qdma, int queue_id,
 	enum trtcm_param mode = TRTCM_METER_MODE;
 	int err;
 
+	if (airoha_is_7581(qdma->eth) && queue_id == 9)
+		tick_sel = true;
+
 	mode |= unit == TRTCM_PACKET_UNIT ? TRTCM_PKT_MODE : 0;
 	err = airoha_qdma_set_rl_config(qdma, queue_id, REG_INGRESS_TRTCM_CFG,
 					enable, mode);
@@ -3753,6 +3761,48 @@ static int airoha_qdma_init_rl_config(struct airoha_qdma *qdma, int queue_id,
 					 tick_sel, TRTCM_TICK_SEL);
 }
 
+static int airoha_qdma_set_factory_rx_limits(struct airoha_qdma *qdma)
+{
+	/* Final XG-040G-MD factory limits in packets per second. */
+	static const u32 limits[AIROHA_NUM_RX_RING] = {
+		4000, 1000000, 4000, 4000,
+		4000, 1000000, 1000, 1000,
+		1000, 1000, 1000000, 4000,
+		1000000, 1000000, 1000000, 1000000,
+		1000000, 1000000, 1000000, 1000000,
+		1000000, 1000000, 1000000, 1000000,
+		1000000, 1000000, 1000000, 1000000,
+		1000000, 1000000, 1000000, 1000000,
+	};
+	struct airoha_eth *eth = qdma->eth;
+	int i, err;
+
+	if (!airoha_is_7581(eth))
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(limits); i++) {
+		u32 rate = limits[i];
+
+		/* The factory startup script uses 1000pps for WAN ring 11. */
+		if (qdma == &eth->qdma[1] && i == 11)
+			rate = 1000;
+
+		err = airoha_qdma_init_rl_config(qdma, i, true,
+						 TRTCM_PACKET_UNIT);
+		if (err)
+			return err;
+
+		err = airoha_qdma_set_rl_token_bucket(qdma, i, rate, rate);
+		if (err)
+			return err;
+	}
+
+	/* The factory enables ingress rate-limit mode after programming rings. */
+	airoha_qdma_set(qdma, REG_INGRESS_TRTCM_CFG, INGRESS_TRTCM_MODE_MASK);
+
+	return 0;
+}
+
 static int airoha_qdma_get_trtcm_param(struct airoha_qdma *qdma, int channel,
 				       u32 addr, enum trtcm_param_type param,
 				       enum trtcm_mode_type mode,
